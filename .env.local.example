# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://nnnldbtfmgbzqjqwwfll.supabase.co
# Service role key — SERVER ONLY, never expose to the browser.
# Supabase Dashboard → Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=

# Admin gate for /admin/comments and DELETE /api/comments/:id
# Use a long random string, e.g. `openssl rand -hex 32`


# Email notifications on new comments (Resend)
# https://resend.com → API Keys
RESEND_API_KEY=
# Address that receives the "new comment" notification
NOTIFY_EMAIL=
# Verified sender (must be a domain/address verified in Resend)
NOTIFY_FROM="Her Journeys <comments@yourdomain.com>"
